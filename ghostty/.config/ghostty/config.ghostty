macos-titlebar-style = tabs
macos-window-buttons = hidden

theme = "TokyoNight"
background-opacity = 0.92
background-blur = 20

font-family = "JetBrains Mono"
font-size = 16

# Keep terminal shortcuts independent of the active keyboard layout.
keybind = cmd+KeyC=copy_to_clipboard
keybind = cmd+KeyV=paste_from_clipboard

# Send the standard ASCII Ctrl codes from physical US-letter positions. This
# keeps readline, Codex, Claude Code, fzf and other TUIs working in Cyrillic.
keybind = ctrl+KeyA=text:\x01
keybind = ctrl+KeyB=text:\x02
keybind = ctrl+KeyC=text:\x03
keybind = ctrl+KeyD=text:\x04
keybind = ctrl+KeyE=text:\x05
keybind = ctrl+KeyF=text:\x06
keybind = ctrl+KeyG=text:\x07
keybind = ctrl+KeyH=text:\x08
keybind = ctrl+KeyI=text:\x09
keybind = ctrl+KeyJ=text:\x0a
keybind = ctrl+KeyK=text:\x0b
keybind = ctrl+KeyL=text:\x0c
keybind = ctrl+KeyM=text:\x0d
keybind = ctrl+KeyN=text:\x0e
keybind = ctrl+KeyO=text:\x0f
keybind = ctrl+KeyP=text:\x10
keybind = ctrl+KeyQ=text:\x11
keybind = ctrl+KeyR=text:\x12
keybind = ctrl+KeyS=text:\x13
keybind = ctrl+KeyT=text:\x14
keybind = ctrl+KeyU=text:\x15
keybind = ctrl+KeyV=text:\x16
keybind = ctrl+KeyW=text:\x17
keybind = ctrl+KeyX=text:\x18
keybind = ctrl+KeyY=text:\x19
keybind = ctrl+KeyZ=text:\x1a

# Slow down mouse-wheel scrolling (default is discrete:3)
mouse-scroll-multiplier = discrete:1
